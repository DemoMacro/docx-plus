{
  "name": "@office-open/core",
  "version": "0.14.2",
  "description": "Shared OOXML infrastructure for office-open — part descriptors, charts, drawings, tables, VML, and unit converters",
  "keywords": [
    "chart",
    "drawing",
    "office-open",
    "ooxml",
    "openxml",
    "shared",
    "types",
    "vml",
    "xml"
  ],
  "homepage": "https://www.office-open.com",
  "bugs": {
    "url": "https://github.com/DemoMacro/office-open/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Demo Macro",
    "email": "abc@imst.xyz",
    "url": "https://www.demomacro.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DemoMacro/office-open.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./smartart": {
      "types": "./dist/smartart/index.d.mts",
      "import": "./dist/smartart/index.mjs"
    },
    "./chart": {
      "types": "./dist/chart/index.d.mts",
      "import": "./dist/chart/index.mjs"
    },
    "./drawing": {
      "types": "./dist/drawing/index.d.mts",
      "import": "./dist/drawing/index.mjs"
    },
    "./vector": {
      "types": "./dist/vector/index.d.mts",
      "import": "./dist/vector/index.mjs"
    },
    "./descriptor": {
      "types": "./dist/descriptor/index.d.mts",
      "import": "./dist/descriptor/index.mjs"
    },
    "./patch": {
      "types": "./dist/patch/index.d.mts",
      "import": "./dist/patch/index.mjs"
    },
    "./theme": {
      "types": "./dist/theme/index.d.mts",
      "import": "./dist/theme/index.mjs"
    },
    "./util": {
      "types": "./dist/util/index.d.mts",
      "import": "./dist/util/index.mjs"
    }
  },
  "scripts": {
    "dev": "basis build --stub",
    "build": "vp pack",
    "prepack": "pnpm build",
    "test": "vp test run",
    "check": "vp check --fix",
    "bench": "vp test bench"
  },
  "dependencies": {
    "@noble/hashes": "2.3.0",
    "@office-open/xml": "workspace:*",
    "fflate": "0.8.3"
  }
}
